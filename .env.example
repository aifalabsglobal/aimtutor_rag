# ============================================
# DeepTutor Environment Template
# ============================================
# Copy this file to `.env` and fill in your values.
# Core runtime settings are grouped as:
# ports / llm / embedding / search / docker-cloud / security

# --------------------------------------------
# Ports
# --------------------------------------------
BACKEND_PORT=8001
FRONTEND_PORT=3782

# --------------------------------------------
# LLM (Required)
# --------------------------------------------
# Supported bindings: openai, lm_studio, ollama, azure_openai, deepseek, ...
# For a full list run: deeptutor provider list // README
LLM_BINDING=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-xxx
LLM_HOST=https://api.openai.com/v1
LLM_API_VERSION=

# --------------------------------------------
# Embedding (Required for knowledge base features)
# --------------------------------------------
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_HOST=https://api.openai.com/v1
EMBEDDING_DIMENSION=3072
EMBEDDING_API_VERSION=
# Whether to send the `dimensions` request parameter to the embedding endpoint.
#   true   -> always send  (only OpenAI text-embedding-3* officially supports it)
#   false  -> never send   (set this for Qwen text-embedding-v4 and other providers
#                          that return HTTP 400 when `dimensions` is present)
#   <empty> or unset -> auto: send only for OpenAI text-embedding-3* family
EMBEDDING_SEND_DIMENSIONS=

# ⚠️  Docker + local LLM (LM Studio / Ollama / vLLM)
# ─────────────────────────────────────────────────────
# When running DeepTutor in Docker and your LLM runs on the HOST machine:
#   - Do NOT use "localhost" or "127.0.0.1" — inside the container these
#     refer to the container itself, not the host.
#   - macOS / Windows Docker Desktop: use http://host.docker.internal:<port>/v1
#   - Linux: use the host's LAN IP, e.g. http://192.168.1.100:<port>/v1
#     (or run Docker with --network=host)
#
# Example (LM Studio on port 1234):
#   LLM_BINDING=lm_studio
#   LLM_HOST=http://host.docker.internal:1234/v1
#   EMBEDDING_BINDING=lm_studio
#   EMBEDDING_HOST=http://host.docker.internal:1234/v1

# --------------------------------------------
# Web Search (Optional)
# --------------------------------------------
# SEARCH_PROVIDER:
#   brave | tavily | jina | searxng | duckduckgo | perplexity | serper | serpapi
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_BASE_URL=

# SerpAPI image enrichment (Optional)
# When set, chat web_search calls additionally fetch top images from
# Google Images (via https://serpapi.com) and surface them inline in the
# conversation, regardless of which SEARCH_PROVIDER is selected above.
# ``SERP_API_KEY`` is also accepted as an alias.
SERPAPI_API_KEY=

# --------------------------------------------
# Web frontend — Clerk auth (Optional)
# --------------------------------------------
# When both are set, the Next.js app protects routes and shows sign-in.
# Create a Clerk app at https://dashboard.clerk.com/ and paste keys into web/.env.local
# (or set these in the environment that runs `npm run dev` / `npm run build` for `web/`).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --------------------------------------------
# Docker / Cloud deployment (Optional)
# --------------------------------------------
# Public backend URL used by the frontend when deployed remotely.
NEXT_PUBLIC_API_BASE_EXTERNAL=
# Alternative direct API base URL.
NEXT_PUBLIC_API_BASE=

# --------------------------------------------
# Live Voice Session (Optional)
# --------------------------------------------
# The /live page (full-duplex voice tutoring) uses an in-memory store for
# per-user mastery state by default. Set REDIS_URL to persist mastery across
# restarts and share state across worker processes. The backend gracefully
# falls back to in-memory if Redis is unreachable.
#   Local:  redis://localhost:6379/0
#   Docker: redis://redis:6379/0
REDIS_URL=

# Optional: paste the Clerk JWT public key here to skip a JWKS network round
# trip on each WebSocket connection. Leave blank to use JWKS (recommended for
# most setups). Find it at Clerk dashboard → JWT templates → Public JWKS.
CLERK_JWT_KEY=

# --------------------------------------------
# Security / Networking (Optional)
# --------------------------------------------
# Keep this false in production.
DISABLE_SSL_VERIFY=false
